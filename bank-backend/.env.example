# Database configurations
USER_DB_NAME=ai_wallet_users
USER_DB_USER=postgres
USER_DB_PASSWORD=your_password_here
USER_DB_HOST=localhost
USER_DB_PORT=5432

ACCOUNT_DB_NAME=ai_wallet_accounts
ACCOUNT_DB_USER=postgres
ACCOUNT_DB_PASSWORD=your_password_here
ACCOUNT_DB_HOST=localhost
ACCOUNT_DB_PORT=5432

TRANSFER_DB_NAME=ai_wallet_transfers
TRANSFER_DB_USER=postgres
TRANSFER_DB_PASSWORD=your_password_here
TRANSFER_DB_HOST=localhost
TRANSFER_DB_PORT=5432

BILL_DB_NAME=ai_wallet_bills
BILL_DB_USER=postgres
BILL_DB_PASSWORD=your_password_here
BILL_DB_HOST=localhost
BILL_DB_PORT=5432

LOAN_DB_NAME=ai_wallet_loans
LOAN_DB_USER=postgres
LOAN_DB_PASSWORD=your_password_here
LOAN_DB_HOST=localhost
LOAN_DB_PORT=5432

ANALYTICS_DB_NAME=ai_wallet_analytics
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=your_password_here
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432

# Security
SECRET_KEY=your-secret-key-here-generate-a-secure-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# OpenAI / LLM Settings
OPENAI_API_KEY=your-openai-api-key-here
# Optional: For OpenRouter or other OpenAI-compatible APIs
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o
