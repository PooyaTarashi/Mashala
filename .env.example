# ==============================================================================
# Mashala Frontend & Runtime Configuration
# ==============================================================================
# Server-only Gemini configuration. Supply your real Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: Override banking backend URL if different from default
# NEXT_PUBLIC_AI_WALLET_BACKEND=http://127.0.0.1:8000

# ==============================================================================
# Backend Security Overrides (Optional)
# In production, ALWAYS generate secure random keys instead of using dev defaults.
# ==============================================================================
# DJANGO_SECRET_KEY=generate_a_secure_random_key_here
# JWT_SECRET_KEY=generate_a_secure_jwt_key_here
# DB_PASSWORD=generate_a_secure_db_password_here

# Optional: Only needed for standalone backend assistant endpoint (/api/v1/chat/process/)
# OPENAI_API_KEY=
